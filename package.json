{
  "name": "aevoryn-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy:pages": "wrangler pages deploy out --project-name aevoryn-web --commit-dirty=true",
    "deploy:worker": "cd worker && wrangler deploy --env=\"\"",
    "deploy": "npm run build && npm run deploy:pages && npm run deploy:worker"
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  }
}
